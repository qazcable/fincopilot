// Все денежные суммы — BigInt в тиынах (1 ₸ = 100 тиын).
// Строковые "enum"-поля проверяются в коде (src/lib/domain).

datasource db {
  provider  = "postgresql"
  // Пул соединений Neon — для приложения
  url       = env("DATABASE_URL")
  // Прямое соединение — для миграций
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(cuid())
  telegramId       BigInt   @unique
  username         String?
  firstName        String?
  timezone         String   @default("Asia/Almaty")
  // Неприкосновенный остаток, который не участвует в лимите на день
  cushion          BigInt   @default(0)
  remindersEnabled Boolean  @default(true)
  // Итоги в боте: утром — лимит на день, вечером — итоги дня, по понедельникам — итоги недели
  morningDigest    Boolean  @default(true)
  eveningDigest    Boolean  @default(true)
  weeklyDigest     Boolean  @default(true)
  // Локальные даты (YYYY-MM-DD) последней отправки — защита от дублей при повторном запуске крона
  lastMorningOn    String?
  lastEveningOn    String?
  lastWeeklyOn     String?
  onboardedAt      DateTime?
  // sha256 от ключа для Apple Shortcuts; сам ключ показывается один раз
  apiKeyHash       String?  @unique
  apiKeyHint       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  obligations      Obligation[]
  payments         ScheduledPayment[]
  incomes          RecurringIncome[]
  limitAlerts      CategoryLimitAlert[]
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  // CARD | CASH | SAVINGS
  kind           String        @default("CARD")
  openingBalance BigInt        @default(0)
  // Учитывать ли счёт в лимите на день (накопления — нет)
  inBudget       Boolean       @default(true)
  isDefault      Boolean       @default(false)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  transactions   Transaction[]

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Стабильный ключ стандартной категории (food, cafe, ...) — для автоподбора
  key          String?
  name         String
  // EXPENSE | INCOME
  kind         String
  emoji        String
  color        String
  sortOrder    Int           @default(0)
  // Лимит расходов на календарный месяц (только для EXPENSE); null — без лимита
  monthlyLimit BigInt?
  archivedAt   DateTime?
  transactions Transaction[]
  limitAlerts  CategoryLimitAlert[]

  @@unique([userId, key])
  @@index([userId, kind])
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // EXPENSE | INCOME
  kind               String
  amount             BigInt
  occurredAt         DateTime          @default(now())
  note               String?
  // APP | BOT_TEXT | BOT_VOICE | SHORTCUT | PAYMENT
  source             String            @default("APP")
  rawInput           String?
  scheduledPaymentId String?           @unique
  scheduledPayment   ScheduledPayment? @relation(fields: [scheduledPaymentId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([userId, occurredAt])
}

model Obligation {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  // LOAN | CREDIT_CARD | INSTALLMENT | BILL
  kind           String
  monthlyAmount  BigInt
  dueDay         Int
  // Для BILL — null (тела долга нет)
  principalLeft  BigInt?
  principalTotal BigInt?
  interestRate   Float?
  graceUntil     DateTime?
  // С какой даты (локальной, YYYY-MM-DD) строить график
  startsOn       String
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  payments       ScheduledPayment[]

  @@index([userId])
}

model ScheduledPayment {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligationId String
  obligation   Obligation   @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  // Локальная дата платежа YYYY-MM-DD
  dueOn        String
  amount       BigInt
  // PENDING | PAID | SKIPPED
  status       String       @default("PENDING")
  paidAt       DateTime?
  remindedAt   DateTime?
  transaction  Transaction?

  @@unique([obligationId, dueOn])
  @@index([userId, status, dueOn])
}

// Отправленные предупреждения о лимите: не больше одного на порог (80% и 100%) в месяц
model CategoryLimitAlert {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // YYYY-MM
  month      String
  // 80 | 100
  level      Int
  createdAt  DateTime @default(now())

  @@unique([categoryId, month, level])
}

model RecurringIncome {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  amount     BigInt?
  dayOfMonth Int
  createdAt  DateTime @default(now())

  @@index([userId])
}
