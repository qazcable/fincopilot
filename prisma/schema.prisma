// Все денежные суммы — BigInt в тиынах (1 ₸ = 100 тиын).
// Строковые "enum"-поля проверяются в коде (src/lib/domain).

datasource db {
  provider  = "postgresql"
  // Пул соединений Neon — для приложения
  url       = env("DATABASE_URL")
  // Прямое соединение — для миграций
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(cuid())
  telegramId       BigInt   @unique
  username         String?
  firstName        String?
  timezone         String   @default("Asia/Almaty")
  // Основная валюта учёта (ISO-код): все суммы пользователя хранятся и показываются в ней
  currency         String   @default("KZT")
  // Дополнительная валюта для справки («≈ 85 $») по курсу Нацбанка; null — не показывать
  secondaryCurrency String? @default("USD")
  // Неприкосновенный остаток, который не участвует в лимите на день
  cushion          BigInt   @default(0)
  remindersEnabled Boolean  @default(true)
  // Итоги в боте: утром — лимит на день, вечером — итоги дня, по понедельникам — итоги недели
  morningDigest    Boolean  @default(true)
  eveningDigest    Boolean  @default(true)
  weeklyDigest     Boolean  @default(true)
  // Локальные даты (YYYY-MM-DD) последней отправки — защита от дублей при повторном запуске крона
  lastMorningOn    String?
  lastEveningOn    String?
  lastWeeklyOn     String?
  onboardedAt      DateTime?
  // sha256 от ключа для Apple Shortcuts; сам ключ показывается один раз
  apiKeyHash       String?  @unique
  apiKeyHint       String?
  // Доступ по приглашению: когда выдан и кто пригласил (владельцы из ALLOWED_TELEGRAM_IDS входят без приглашения)
  accessGrantedAt  DateTime?
  invitedById      String?
  // Тариф: FREE — с лимитами, PRO — без них. proUntil = null при PRO означает бессрочный доступ (беты и близкие)
  plan             String   @default("FREE")
  proUntil         DateTime?
  // Конец бесплатного пробного периода Pro
  trialEndsAt      DateTime?
  // Расход ИИ на бесплатном тарифе: месяц YYYY-MM и число разборов в нём
  aiMonth          String?
  aiCount          Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invitesCreated   Invite[]   @relation("InviteCreator")
  invitesUsed      Invite[]   @relation("InviteUser")
  feedback         Feedback[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  obligations      Obligation[]
  payments         ScheduledPayment[]
  incomes          RecurringIncome[]
  limitAlerts      CategoryLimitAlert[]
  imports          ImportBatch[]
  merchants        MerchantCategory[]
  goals            Goal[]
  advisorMessages  AdvisorMessage[]
  debts            Debt[]
  payments2        Payment[]
}

// Оплата подписки: пока принимается переводом на Kaspi и отмечается владельцем вручную
model Payment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    BigInt
  months    Int
  // KASPI | CARD | GIFT
  method    String   @default("KASPI")
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Долг человеку или человека мне: не кредит банка, а «занял у друга» / «дал в долг»
model Debt {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Имя человека
  person    String
  // OUT — я должен, IN — мне должны
  direction String
  amount    BigInt
  // Локальная дата возврата (YYYY-MM-DD), если договорились
  dueOn     String?
  note      String?
  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, settledAt])
}

// Одноразовое приглашение: ссылка t.me/<бот>?start=inv_<code>
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  // Для кого — чтобы владелец помнил, кому отправил
  note        String?
  usedById    String?
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
}

// Отзывы тестировщиков: из бота (/feedback) и приложения
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  // BOT | APP
  source    String
  // Экран приложения, с которого отправлен отзыв
  page      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Переписка с ИИ-советником — общая для бота и приложения
model AdvisorMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // user | assistant
  role      String
  text      String
  // BOT | APP
  source    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  // CARD | CASH | SAVINGS
  kind           String        @default("CARD")
  openingBalance BigInt        @default(0)
  // Учитывать ли счёт в лимите на день (накопления — нет)
  inBudget       Boolean       @default(true)
  isDefault      Boolean       @default(false)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  incoming       Transaction[] @relation("IncomingTransfers")
  goals          Goal[]

  @@index([userId])
}

// Цель накоплений. Прогресс — баланс привязанного счёта «Накопления», распределённый между целями по порядку
model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title        String
  emoji        String    @default("🎯")
  targetAmount BigInt
  // Локальная дата YYYY-MM-DD; без даты — копим без срока
  targetDate   String?
  sortOrder    Int       @default(0)
  achievedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Стабильный ключ стандартной категории (food, cafe, ...) — для автоподбора
  key          String?
  name         String
  // EXPENSE | INCOME
  kind         String
  emoji        String
  color        String
  sortOrder    Int           @default(0)
  // Лимит расходов на календарный месяц (только для EXPENSE); null — без лимита
  monthlyLimit BigInt?
  archivedAt   DateTime?
  transactions Transaction[]
  limitAlerts  CategoryLimitAlert[]
  merchants    MerchantCategory[]

  @@unique([userId, key])
  @@index([userId, kind])
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // EXPENSE | INCOME | TRANSFER (перевод между своими счетами: accountId → toAccountId)
  kind               String
  toAccountId        String?
  toAccount          Account?          @relation("IncomingTransfers", fields: [toAccountId], references: [id], onDelete: Cascade)
  amount             BigInt
  occurredAt         DateTime          @default(now())
  note               String?
  // APP | BOT_TEXT | BOT_VOICE | SHORTCUT | PAYMENT
  source             String            @default("APP")
  rawInput           String?
  scheduledPaymentId String?           @unique
  scheduledPayment   ScheduledPayment? @relation(fields: [scheduledPaymentId], references: [id], onDelete: SetNull)
  // Импорт из выписки: пакет (для отмены) и стабильный ключ строки (защита от повторного импорта)
  importBatchId      String?
  importBatch        ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importKey          String?
  // Пользователь подтвердил, что это не перевод между своими счетами — больше не предлагать связывать
  notOwnTransfer     Boolean           @default(false)
  createdAt          DateTime          @default(now())

  @@unique([userId, importKey])
  @@index([userId, occurredAt])
  @@index([importBatchId])
}

model ImportBatch {
  id                     String        @id @default(cuid())
  userId                 String
  user                   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId              String
  // KASPI_GOLD
  bank                   String
  // DRAFT | APPLIED | CANCELLED
  status                 String        @default("DRAFT")
  periodFrom             String?
  periodTo               String?
  closingBalance         BigInt?
  // Начальный остаток счёта до импорта — чтобы откат вернул баланс как был
  previousOpeningBalance BigInt?
  // Разобранные строки выписки с решениями (JSON)
  rows                   Json
  summary                Json
  createdAt              DateTime      @default(now())
  appliedAt              DateTime?
  cancelledAt            DateTime?
  transactions           Transaction[]

  @@index([userId, createdAt])
}

// Выученная категория магазина: подбирается при импорте и уточняется, когда пользователь меняет категорию
model MerchantCategory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt

  @@unique([userId, merchant])
}

model Obligation {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  // LOAN | CREDIT_CARD | INSTALLMENT | BILL
  kind           String
  monthlyAmount  BigInt
  dueDay         Int
  // Для BILL — null (тела долга нет)
  principalLeft  BigInt?
  principalTotal BigInt?
  interestRate   Float?
  graceUntil     DateTime?
  // С какой даты (локальной, YYYY-MM-DD) строить график
  startsOn       String
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  payments       ScheduledPayment[]

  @@index([userId])
}

model ScheduledPayment {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  obligationId String
  obligation   Obligation   @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  // Локальная дата платежа YYYY-MM-DD
  dueOn        String
  amount       BigInt
  // PENDING | PAID | SKIPPED
  status       String       @default("PENDING")
  paidAt       DateTime?
  remindedAt   DateTime?
  transaction  Transaction?

  @@unique([obligationId, dueOn])
  @@index([userId, status, dueOn])
}

// Отправленные предупреждения о лимите: не больше одного на порог (80% и 100%) в месяц
model CategoryLimitAlert {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // YYYY-MM
  month      String
  // 80 | 100
  level      Int
  createdAt  DateTime @default(now())

  @@unique([categoryId, month, level])
}

model RecurringIncome {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  amount     BigInt?
  dayOfMonth Int
  createdAt  DateTime @default(now())

  @@index([userId])
}
