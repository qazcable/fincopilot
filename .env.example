# PostgreSQL (Neon). На Vercel обе переменные создаёт интеграция Neon.
# Для локальной разработки — строка `npx prisma dev` из README
# Пул соединений — для приложения
DATABASE_URL=""
# Прямое соединение — для миграций
DATABASE_URL_UNPOOLED=""

# Telegram
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_BOT_USERNAME=""
# Любая длинная случайная строка — Telegram присылает её в заголовке вебхука
TELEGRAM_WEBHOOK_SECRET=""
# Через запятую: только эти Telegram ID смогут пользоваться ботом и приложением (пусто — все)
ALLOWED_TELEGRAM_IDS=""

# Публичный https-адрес приложения
APP_URL=""

# Подпись сессионной cookie — длинная случайная строка
SESSION_SECRET=""

# Защита /api/cron/reminders
CRON_SECRET=""

# Gemini — разбор свободного текста и голосовых (без ключа работает только быстрый разбор «кофе 1200»)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Только для разработки: открыть приложение в обычном браузере под этим Telegram ID
DEV_TELEGRAM_ID=""
